.     quietly xtreg b_outcome __xL __xH `full_controls_debt' i.year if sample_criterion_`key', fe vce(cluster country_id)
 94.     scalar __criterion_r2w = e(r2_w)
 95.     quietly areg b_outcome __xL __xH `full_controls_debt' i.year if sample_criterion_`key', absorb(country_id) vce(cluster country_id)
 96.     scalar __criterion_betaL = _b[__xL]
 97.     scalar __criterion_betaH = _b[__xH]
 98.     scalar __criterion_pL = 2*ttail(e(df_r),abs(_b[__xL]/_se[__xL]))
 99.     scalar __criterion_pH = 2*ttail(e(df_r),abs(_b[__xH]/_se[__xH]))
100.     scalar __criterion_rss = e(rss)
101.     local signL = cond(scalar(__criterion_betaL)>0,"+",cond(scalar(__criterion_betaL)<0,"-","0"))
102.     local signH = cond(scalar(__criterion_betaH)>0,"+",cond(scalar(__criterion_betaH)<0,"-","0"))
103.     local theory "No (`signL',`signH')"
104.     if (scalar(__criterion_betaL)>0 & scalar(__criterion_betaH)<0) local theory "Match (+,-)"
105.     else if (scalar(__criterion_betaL)>0 | scalar(__criterion_betaH)<0) local theory "Partial (`signL',`signH')"
106.     post `p_compare' ("`qlabel'") ("`qvar'") (scalar(cutoff_`key')) (scalar(__criterion_betaL)) (scalar(__criterion_pL)) (scalar(__criterion_betaH)) (scalar(__criterion_pH)) ("`theory'") (scalar(__criterion_rss)) (scalar(__criterion_r2w)) (e(N)) (sca
> lar(low_n_`key')) (scalar(high_n_`key')) (scalar(candidate_count_`key')) (scalar(q_p10_`key')) (scalar(q_p90_`key')) (e(N_clust)) ("country_id")

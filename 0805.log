 37.     format `qvar' %21.15g
 38.     quietly levelsof `qvar' if sample_criterion_`key' & `qvar'>=scalar(q_p10_`key') & `qvar'<=scalar(q_p90_`key'), local(candidates) clean
 39. 
.     scalar rss_min_`key' = .
 40.     scalar cutoff_`key' = .
 41.     scalar candidate_count_`key' = 0
 42.     scalar low_n_`key' = .
 43.     scalar high_n_`key' = .
 44.     generate double __hL = .
 45.     generate double __hH = .
 46.     generate double __xL = .
 47.     generate double __xH = .
 48.     local minside = max(50,ceil(.10*scalar(N_criterion_`key')))
 49. 
.     foreach c of local candidates {
 50.         quietly count if sample_criterion_`key' & `qvar'<=`c'
 51.         local nlow = r(N)
 52.         quietly count if sample_criterion_`key' & `qvar'>`c'
 53.         local nhigh = r(N)
 54.         if `nlow'>=`minside' & `nhigh'>=`minside' {
 55.             quietly replace __hL = max(`c'-`qvar',0) if sample_criterion_`key'
 56.             quietly replace __hH = max(`qvar'-`c',0) if sample_criterion_`key'
 57.             quietly replace __xL = readiness100*__hL if sample_criterion_`key'
 58.             quietly replace __xH = readiness100*__hH if sample_criterion_`key'
 59.             quietly areg b_outcome __xL __xH `full_controls_debt' i.year if sample_criterion_`key', absorb(country_id) vce(cluster country_id)
 60.             local this_rss = e(rss)
 61.             post `p_profile' ("`qlabel'") ("`qvar'") (`c') (`this_rss') (e(N)) (`nlow') (`nhigh')
 62.             scalar candidate_count_`key' = scalar(candidate_count_`key')+1
 63.             if missing(scalar(rss_min_`key')) | `this_rss'<scalar(rss_min_`key') {
 64.                 scalar rss_min_`key' = `this_rss'
 65.                 scalar cutoff_`key' = `c'
 66.                 scalar low_n_`key' = `nlow'
 67.                 scalar high_n_`key' = `nhigh'
 68.             }
 69.         }
 70.     }
 71.     if missing(scalar(cutoff_`key')) {
 72.         display as error "No admissible cutoff for criterion `qlabel'."
 73.         postclose `p_profile'
 74.         postclose `p_compare'
 75.         postclose `p_formula'
 76.         log close nostatelog
 77.         exit 498
 78.     }
 79. 
.     quietly replace __hL = max(scalar(cutoff_`key')-`qvar',0) if sample_criterion_`key'
 80.     quietly replace __hH = max(`qvar'-scalar(cutoff_`key'),0) if sample_criterion_`key'
 81.     quietly replace __xL = readiness100*__hL if sample_criterion_`key'
 82.     quietly replace __xH = readiness100*__hH if sample_criterion_`key'
 83.     generate double __formula = readiness100*max(scalar(cutoff_`key')-`qvar',0) if sample_criterion_`key'
 84.     generate double __diff = abs(__xL-__formula) if sample_criterion_`key'
 85.     quietly summarize __diff, meanonly
 86.     scalar formula_low_`key' = cond(r(N)>0,r(max),.)
 87.     drop __formula __diff
 88.     generate double __formula = readiness100*max(`qvar'-scalar(cutoff_`key'),0) if sample_criterion_`key'
 89.     generate double __diff = abs(__xH-__formula) if sample_criterion_`key'
 90.     quietly summarize __diff, meanonly

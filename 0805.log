  9.         local sdw = r(sd_w)
 10.         local ratio = cond(`sdo'>0,`sdw'/`sdo',.)
 11.         local ident "adequate"
 12.         if missing(`sdw') | `sdw'<=1e-10*max(1,`sdo') local ident "not_identified_by_FE"
 13.         else if `ratio'<.01 local ident "low_within_variation"
 14.         post `p_var' ("`eq'") ("`v'") (`sdo') (`sdb') (`sdw') (`ratio') ("`ident'")
 15.     }
 16. }

. postclose `p_var'


. * -----------------------------------------------------------------------------
. * Criterion Decomposition / Competing Criterion Test.
. * -----------------------------------------------------------------------------
. tempname p_profile p_compare

. postfile `p_profile' str12 criterion str32 variable double cutoff rss N N_low N_high using "`outdir'/criterion_rss_profiles.dta", replace

. postfile `p_compare' str12 criterion str32 variable double cutoff beta_L p_L beta_H p_H str24 theoretical_signs double rss r2_within N N_low N_high candidate_count trim_low trim_high using "`outdir'/criterion_comparison.dta", replace

. 
. local criterion_keys theta debt ma ta bma

. foreach key of local criterion_keys {
  2.     if "`key'"=="theta" {
  3.         local qvar theta_hat_A
  4.         local qlabel "theta"
  5.     }
  6.     if "`key'"=="debt" {
  7.         local qvar debt_gdp
  8.         local qlabel "b"
  9.     }
 10.     if "`key'"=="ma" {
 11.         local qvar mA_hat
 12.         local qlabel "mA"
 13.     }
 14.     if "`key'"=="ta" {
 15.         local qvar TA_hat
 16.         local qlabel "TA"
 17.     }
 18.     if "`key'"=="bma" {
 19.         local qvar bmA_hat
 20.         local qlabel "b*mA"
 21.     }
 22. 
.     quietly summarize `qvar' if sample_debt_ns, detail
 23.     scalar q_min_`key' = r(min)
 24.     scalar q_p1_`key' = r(p1)
 25.     scalar q_p10_`key' = r(p10)
 26.     scalar q_p25_`key' = r(p25)
 27.     scalar q_p50_`key' = r(p50)
 28.     scalar q_mean_`key' = r(mean)
 29.     scalar q_p75_`key' = r(p75)
 30.     scalar q_p90_`key' = r(p90)
 31.     scalar q_p99_`key' = r(p99)
 32.     scalar q_max_`key' = r(max)
 33.     format `qvar' %21.15g
 34.     quietly levelsof `qvar' if sample_debt_ns & `qvar'>=scalar(q_p10_`key') & `qvar'<=scalar(q_p90_`key'), local(candidates) clean
 35. 
.     scalar rss_min_`key' = .
 36.     scalar cutoff_`key' = .
 37.     scalar candidate_count_`key' = 0
 38.     scalar low_n_`key' = .
 39.     scalar high_n_`key' = .
 40.     generate double __hL = .
 41.     generate double __hH = .
 42.     generate double __xL = .
 43.     generate double __xH = .
 44.     local minside = max(50,ceil(.10*scalar(N_debt_ns)))
 45. 
.     foreach c of local candidates {
 46.         quietly count if sample_debt_ns & `qvar'<=`c'
 47.         local nlow = r(N)
 48.         quietly count if sample_debt_ns & `qvar'>`c'
 49.         local nhigh = r(N)
 50.         if `nlow'>=`minside' & `nhigh'>=`minside' {
 51.             quietly replace __hL = max(`c'-`qvar',0) if sample_debt_ns
 52.             quietly replace __hH = max(`qvar'-`c',0) if sample_debt_ns
 53.             quietly replace __xL = readiness100*__hL if sample_debt_ns
 54.             quietly replace __xH = readiness100*__hH if sample_debt_ns
 55.             quietly areg b_outcome __xL __xH `full_controls_debt' i.year if sample_debt_ns, absorb(country_id)
 56.             local this_rss = e(rss)
 57.             post `p_profile' ("`qlabel'") ("`qvar'") (`c') (`this_rss') (e(N)) (`nlow') (`nhigh')
 58.             scalar candidate_count_`key' = scalar(candidate_count_`key')+1
 59.             if missing(scalar(rss_min_`key')) | `this_rss'<scalar(rss_min_`key') {
 60.                 scalar rss_min_`key' = `this_rss'
 61.                 scalar cutoff_`key' = `c'
 62.                 scalar low_n_`key' = `nlow'
 63.                 scalar high_n_`key' = `nhigh'
 64.             }
 65.         }
 66.     }
 67.     if missing(scalar(cutoff_`key')) {
 68.         display as error "No admissible cutoff for criterion `qlabel'."
 69.         postclose `p_profile'
 70.         postclose `p_compare'
 71.         postclose `p_formula'
 72.         log close nostatelog
 73.         exit 498
 74.     }
 75. 
.     quietly replace __hL = max(scalar(cutoff_`key')-`qvar',0) if sample_debt_ns
 76.     quietly replace __hH = max(`qvar'-scalar(cutoff_`key'),0) if sample_debt_ns
 77.     quietly replace __xL = readiness100*__hL if sample_debt_ns
 78.     quietly replace __xH = readiness100*__hH if sample_debt_ns
 79.     generate double __formula = readiness100*max(scalar(cutoff_`key')-`qvar',0) if sample_debt_ns
 80.     generate double __diff = abs(__xL-__formula) if sample_debt_ns
 81.     quietly summarize __diff, meanonly
 82.     scalar formula_low_`key' = cond(r(N)>0,r(max),.)
 83.     drop __formula __diff
 84.     generate double __formula = readiness100*max(`qvar'-scalar(cutoff_`key'),0) if sample_debt_ns
 85.     generate double __diff = abs(__xH-__formula) if sample_debt_ns
 86.     quietly summarize __diff, meanonly
 87.     scalar formula_high_`key' = cond(r(N)>0,r(max),.)
 88.     drop __formula __diff
 89. 
.     quietly xtreg b_outcome __xL __xH `full_controls_debt' i.year if sample_debt_ns, fe
 90.     local r2w = e(r2_w)
 91.     quietly areg b_outcome __xL __xH `full_controls_debt' i.year if sample_debt_ns, absorb(country_id) vce(robust)
 92.     local betaL = _b[__xL]
 93.     local betaH = _b[__xH]
 94.     local pL = 2*ttail(e(df_r),abs(_b[__xL]/_se[__xL]))
 95.     local pH = 2*ttail(e(df_r),abs(_b[__xH]/_se[__xH]))
 96.     local finalrss = e(rss)
 97.     local signL = cond(`betaL'>0,"+",cond(`betaL'<0,"-","0"))
 98.     local signH = cond(`betaH'>0,"+",cond(`betaH'<0,"-","0"))
 99.     local theory "No (`signL',`signH')"
100.     if (`betaL'>0 & `betaH'<0) local theory "Match (+,-)"
101.     else if (`betaL'>0 | `betaH'<0) local theory "Partial (`signL',`signH')"
102.     post `p_compare' ("`qlabel'") ("`qvar'") (scalar(cutoff_`key')) (`betaL') (`pL') (`betaH') (`pH') ("`theory'") (`finalrss') (`r2w') (e(N)) (scalar(low_n_`key')) (scalar(high_n_`key')) (scalar(candidate_count_`key')) (scalar(q_p10_`key')) (scalar(
> q_p90_`key'))
103. 
.     post `p_formula' ("criterion `qlabel' low hinge") (scalar(formula_low_`key')) (1e-10) (scalar(formula_low_`key')<=1e-10)
104.     post `p_formula' ("criterion `qlabel' high hinge") (scalar(formula_high_`key')) (1e-10) (scalar(formula_high_`key')<=1e-10)
105.     drop __hL __hH __xL __xH
106. }

  3.     if "`eq'"=="debt" local vars b_outcome theta_hat_A debt_gdp mA_hat TA_hat bmA_hat readiness100 `full_controls_debt'
  4.     if "`eq'"=="ready" local vars A_outcome theta_hat_A interest_revenue `full_controls_ready'

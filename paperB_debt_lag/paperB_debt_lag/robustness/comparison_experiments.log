. * -----------------------------------------------------------------------------
. * Fixed old/new cutoff cross sensitivity on each theta specification's natural
. * full debt-equation sample.
. * -----------------------------------------------------------------------------
. tempname p_cross

. postfile `p_cross' str16 theta_specification str16 cutoff_source double cutoff beta_L se_L p_L beta_H se_H p_H rss r2_within N countries N_low N_high using "`outroot'/cross_cutoff_sensitivity.dta", replace

. foreach spec in current lagged {
  2.     local qvar theta_`spec'
  3.     local svar sample_`spec'
  4.     foreach source in current lagged {
  5.         local c = scalar(cutoff_`source')
  6.         capture drop __xL __xH __est
  7.         generate double __xL = readiness100*max(`c'-`qvar',0) if `svar'
  8.         generate double __xH = readiness100*max(`qvar'-`c',0) if `svar'
  9.         quietly xtreg b_outcome __xL __xH `controls' i.year if `svar', fe vce(cluster panel_id)
 10.         scalar __r2w = e(r2_w)
 11.         quietly areg b_outcome __xL __xH `controls' i.year if `svar', absorb(panel_id) vce(cluster panel_id)
 12.         generate byte __est = e(sample)
 13.         scalar __bL = _b[__xL]
 14.         scalar __sL = _se[__xL]
 15.         scalar __pL = 2*ttail(e(df_r),abs(_b[__xL]/_se[__xL]))
 16.         scalar __bH = _b[__xH]
 17.         scalar __sH = _se[__xH]
 18.         scalar __pH = 2*ttail(e(df_r),abs(_b[__xH]/_se[__xH]))
 19.         scalar __rss = e(rss)
 20.         scalar __N = e(N)
 21.         scalar __G = e(N_clust)
 22.         quietly count if __est & `qvar'<=`c'
 23.         scalar __NL = r(N)
 24.         quietly count if __est & `qvar'>`c'
 25.         scalar __NH = r(N)
 26.         assert scalar(__NL)+scalar(__NH)==scalar(__N)
 27.         post `p_cross' ("`spec'_debt") ("`source'_debt") (`c') (scalar(__bL)) (scalar(__sL)) (scalar(__pL)) (scalar(__bH)) (scalar(__sH)) (scalar(__pH)) (scalar(__rss)) (scalar(__r2w)) (scalar(__N)) (scalar(__G)) (scalar(__NL)) (scalar(__NH))
 28.     }
 29. }

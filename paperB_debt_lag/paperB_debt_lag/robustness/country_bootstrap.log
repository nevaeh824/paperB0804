. 
. forvalues rep=1/`reps' {
  2.     display as text "OUTER BOOTSTRAP REPLICATION `rep'/`reps'"
  3.     use `draws', clear
  4.     keep if replicate==`rep'
  5.     rename source_iso3 iso3
  6.     joinby iso3 using `base'
  7.     rename draw_slot boot_country_id
  8.     isid boot_country_id year
  9.     xtset boot_country_id year
 10. 
.     quietly tabulate year, generate(__year_fe_)
 11.     ds __year_fe_*
 12.     local year_dummies `r(varlist)'
 13.     local base_year_dummy : word 1 of `year_dummies'
 14.     local year_dummies : list year_dummies - base_year_dummy
 15. 
.     generate double spread_lag = L.bond_spreads
 16.     generate double b_current = debt_gdp
 17.     generate double b_lagged = L.debt_gdp
 18.     generate double T_it = ConstantGDP/L.ConstantGDP if !missing(ConstantGDP,L.ConstantGDP) & L.ConstantGDP!=0
 19.     generate double T_lead = F.T_it
 20.     generate double b_outcome = F.debt_gdp-debt_gdp if !missing(F.debt_gdp,debt_gdp)
 21. 
.     * The T equation is identical in the two specifications, so estimate it once
.     * per paired draw and reuse its coefficients without reusing any outcome fit.
.     egen int tax_missing = rowmiss(T_lead T_it readiness100 wsdi_days inflation_cpi reserves tt)
 22.     generate byte sample_tax = tax_missing==0
 23.     quietly summarize readiness100 if sample_tax, meanonly
 24.     scalar mean_A_T = r(mean)
 25.     quietly summarize wsdi_days if sample_tax, meanonly
 26.     scalar mean_X_T = r(mean)
 27.     generate double c_A_T = readiness100-scalar(mean_A_T)
 28.     generate double c_X_T = wsdi_days-scalar(mean_X_T)
 29.     generate double int_AX_T = c_A_T*c_X_T
 30.     capture quietly xtlsdvc T_lead c_A_T c_X_T int_AX_T inflation_cpi reserves tt `year_dummies', initial(bb) bias(2) vcov(0)
 31.     local tax_rc = _rc
 32.     if `tax_rc' {
 33.         foreach spec in current lagged {
 34.             post `p_boot' ("`spec'_debt") (`rep') ("failed") ("T_lsdvc") ("r(`tax_rc')") (.) (.) (.) (.) (.) (.) (.) (.)
 35.         }
 36.         continue
 37.     }
 38.     scalar gamma_A_centered = _b[c_A_T]
 39.     scalar gamma_AX = _b[int_AX_T]
 40.     scalar gamma_A_raw = scalar(gamma_A_centered)-scalar(gamma_AX)*scalar(mean_X_T)
 41.     generate double TA_hat = scalar(gamma_A_raw)+scalar(gamma_AX)*wsdi_days if sample_tax
 42. 
.     foreach spec in current lagged {
 43.         local state b_`spec'
 44.         capture drop spread_missing sample_spread c_A c_X c_b int_AB int_AX mA_hat theta_hat_A debt_missing sample_debt __xL __xH
 45.         egen int spread_missing = rowmiss(bond_spreads spread_lag readiness100 wsdi_days `state' growth inflation_cpi reserves tt)
 46.         generate byte sample_spread = spread_missing==0
 47.         quietly summarize readiness100 if sample_spread, meanonly
 48.         scalar mean_A = r(mean)
 49.         quietly summarize wsdi_days if sample_spread, meanonly
 50.         scalar mean_X = r(mean)
 51.         quietly summarize `state' if sample_spread, meanonly
 52.         scalar mean_b = r(mean)
 53.         generate double c_A = readiness100-scalar(mean_A)
 54.         generate double c_X = wsdi_days-scalar(mean_X)
 55.         generate double c_b = `state'-scalar(mean_b)
 56.         generate double int_AB = c_A*c_b
 57.         generate double int_AX = c_A*c_X
 58.         capture quietly xtlsdvc bond_spreads c_A c_X c_b int_AB int_AX growth inflation_cpi reserves tt `year_dummies', initial(bb) bias(2) vcov(0)
 59.         local spread_rc = _rc
 60.         if `spread_rc' {
 61.             post `p_boot' ("`spec'_debt") (`rep') ("failed") ("spread_lsdvc") ("r(`spread_rc')") (.) (.) (.) (.) (.) (.) (.) (.)
 62.             continue
 63.         }
 64.         scalar beta_A_centered = _b[c_A]
 65.         scalar beta_AB = _b[int_AB]
 66.         scalar beta_AX = _b[int_AX]
 67.         scalar beta_A_raw = scalar(beta_A_centered)-scalar(beta_AB)*scalar(mean_b)-scalar(beta_AX)*scalar(mean_X)
 68.         generate double mA_hat = -(scalar(beta_A_raw)+scalar(beta_AB)*`state'+scalar(beta_AX)*wsdi_days) if sample_spread
 69.         generate double theta_hat_A = `state'*mA_hat+TA_hat if sample_spread & sample_tax & !missing(`state',mA_hat,TA_hat)
 70.         egen int debt_missing = rowmiss(b_outcome readiness100 theta_hat_A wsdi_days growth inflation_cpi reserves tt)
 71.         generate byte sample_debt = debt_missing==0
 72.         quietly count if sample_debt
 73.         scalar N_debt = r(N)
 74.         if scalar(N_debt)<100 {
 75.             post `p_boot' ("`spec'_debt") (`rep') ("failed") ("debt_sample") ("N<100") (.) (.) (.) (.) (scalar(N_debt)) (.) (.) (.)
 76.             continue
 77.         }
 78. 
.         quietly summarize theta_hat_A if sample_debt, detail
 79.         scalar trim_low = r(p10)
 80.         scalar trim_high = r(p90)
 81.         format theta_hat_A %21.15g
 82.         quietly levelsof theta_hat_A if sample_debt & theta_hat_A>=scalar(trim_low) & theta_hat_A<=scalar(trim_high), local(candidates) clean
 83.         scalar best_rss = .
 84.         scalar best_cutoff = .
 85.         scalar best_low = .
 86.         scalar best_high = .
 87.         generate double __xL = .
 88.         generate double __xH = .
 89.         local minside = max(50,ceil(.10*scalar(N_debt)))
 90.         foreach c of local candidates {
 91.             quietly count if sample_debt & theta_hat_A<=`c'
 92.             local nlow = r(N)
 93.             quietly count if sample_debt & theta_hat_A>`c'
 94.             local nhigh = r(N)
 95.             if `nlow'>=`minside' & `nhigh'>=`minside' {
 96.                 quietly replace __xL = readiness100*max(`c'-theta_hat_A,0) if sample_debt
 97.                 quietly replace __xH = readiness100*max(theta_hat_A-`c',0) if sample_debt
 98.                 capture quietly areg b_outcome __xL __xH wsdi_days growth inflation_cpi reserves tt i.year if sample_debt, absorb(boot_country_id) vce(cluster boot_country_id)
 99.                 if !_rc {
100.                     local this_rss = e(rss)
101.                     if missing(scalar(best_rss)) | `this_rss'<scalar(best_rss) {
102.                         scalar best_rss = `this_rss'
103.                         scalar best_cutoff = `c'
104.                         scalar best_low = `nlow'
105.                         scalar best_high = `nhigh'
106.                     }
107.                 }
108.             }
109.         }
110.         if missing(scalar(best_cutoff)) {
111.             post `p_boot' ("`spec'_debt") (`rep') ("failed") ("cutoff_search") ("no admissible fit") (.) (.) (.) (.) (scalar(N_debt)) (.) (.) (.)
112.             continue
113.         }
114.         quietly replace __xL = readiness100*max(scalar(best_cutoff)-theta_hat_A,0) if sample_debt
115.         quietly replace __xH = readiness100*max(theta_hat_A-scalar(best_cutoff),0) if sample_debt
116.         capture quietly areg b_outcome __xL __xH wsdi_days growth inflation_cpi reserves tt i.year if sample_debt, absorb(boot_country_id) vce(cluster boot_country_id)
117.         local debt_rc = _rc
118.         if `debt_rc' {
119.             post `p_boot' ("`spec'_debt") (`rep') ("failed") ("debt_final") ("r(`debt_rc')") (scalar(best_cutoff)) (.) (.) (.) (scalar(N_debt)) (.) (scalar(best_low)) (scalar(best_high))
120.             continue
121.         }
122.         assert scalar(best_low)+scalar(best_high)==e(N)
123.         post `p_boot' ("`spec'_debt") (`rep') ("success") ("") ("") (scalar(best_cutoff)) (_b[__xL]) (_b[__xH]) (e(rss)) (e(N)) (e(N_clust)) (scalar(best_low)) (scalar(best_high))
124.     }
125. }

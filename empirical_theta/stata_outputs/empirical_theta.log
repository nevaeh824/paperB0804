. foreach mid in Y8_interact_core Y9_interact_macro Y10_interact_full {
  2.     estimates restore `mid'
  3.     local xmean = scalar(output_mean_vulnerability100)
  4.     local xsd = scalar(output_sd_vulnerability100)
  5.     local pnames "P10 P25 P50 P75 P90 Mean_minus_1SD Mean Mean_plus_1SD"
  6.     local pvals "`=scalar(output_p10_vulnerability100)' `=scalar(output_p25_vulnerability100)' `=scalar(output_p50_vulnerability100)' `=scalar(output_p75_vulnerability100)' `=scalar(output_p90_vulnerability100)' `=`xmean'-`xsd'' `xmean' `=`xmean'+`xs
> d''"
  7.     forvalues h=1/8 {
  8.         local pn : word `h' of `pnames'
  9.         local pv : word `h' of `pvals'
 10.         local centered = `pv'-`xmean'
 11.         quietly lincom c_A_Y + (`centered')*int_AX_Y
 12.         post `p_marginal' ("`mid'") ("vulnerability100") ("`pn'") (`pv') (r(estimate)) (r(se)) (r(estimate)/r(se)) (r(p)) (r(lb)) (r(ub))
 13.     }
 14.     scalar __threshold = `xmean' - _b[c_A_Y]/_b[int_AX_Y]
 15.     scalar __inrange = (__threshold>=scalar(output_min_vulnerability100) & __threshold<=scalar(output_max_vulnerability100))
 16.     post `p_threshold' ("`mid'") ("vulnerability100") (__threshold) (scalar(output_min_vulnerability100)) (scalar(output_max_vulnerability100)) (__inrange)
 17. }

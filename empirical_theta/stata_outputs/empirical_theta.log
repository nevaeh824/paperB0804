. tempname p_vif

. postfile `p_vif' str24 specification str32 variable double vif tolerance condition_number using "`outdir'/collinearity.dta", replace

. foreach spec in linear interaction {
  2.     local vars `vif_`spec''
  3.     local residuals
  4.     foreach v of local vars {
  5.         local residuals `residuals' tw_`v'
  6.     }
  7.     quietly correlate `residuals' if sample_tax
  8.     matrix __R = r(C)
  9.     mata: st_numscalar("condition_`spec'", sqrt(cond(st_matrix("__R"))))
 10.     foreach v of local vars {
 11.         local rv tw_`v'
 12.         local others : list residuals - rv
 13.         quietly regress `rv' `others' if sample_tax
 14.         local vif = 1/(1-e(r2))
 15.         post `p_vif' ("`spec'") ("`v'") (`vif') (1/`vif') (scalar(condition_`spec'))
 16.     }
 17. }

. postclose `p_vif'


. foreach v of local tax_profilevars {
  2.     quietly xtsum `v' if sample_tax
  3.     local sdo = r(sd)
  4.     local sdb = r(sd_b)
  5.     local sdw = r(sd_w)
  6.     local ratio = cond(`sdo'>0,`sdw'/`sdo',.)
  7.     local ident "adequate"
  8.     if missing(`sdw') | `sdw'<=1e-10*max(1,`sdo') local ident "not_identified_by_FE"
  9.     else if `ratio'<.01 local ident "low_within_variation"
 10.     post `p_variation' ("`v'") (`sdo') (`sdb') (`sdw') (`ratio') ("`ident'")
 11. }


. forvalues z=1/11 {
  2.     local mid "`tm`z''"
  3.     local rhs "`tr`z''"
  4.     local equ "`tq`z''"
  5.     display as text "TAX REGRESSION `mid': `equ'"
  6.     quietly xtreg taxbase_lead `rhs' i.year if sample_tax, fe
  7.     local __r2w = e(r2_w)
  8.     local __r2o = e(r2_o)
  9.     quietly areg taxbase_lead `rhs' i.year if sample_tax, absorb(country_id) vce(robust)
 10.     estimates store `mid'
 11.     post `p_models' ("`mid'") (e(N)) (scalar(G_tax)) (scalar(T_tax)) (scalar(year_min_tax)) (scalar(year_max_tax)) (`__r2w') (`__r2o') (e(df_r)) (1) (1) (`mc`z'') (`ec`z'') (`ix`z'')
 12.     post `p_equations' ("`mid'") ("`equ'")
 13.     foreach v of local rhs {
 14.         capture scalar __b = _b[`v']
 15.         if _rc {
 16.             post `p_coefs' ("`mid'") ("`v'") (.) (.) (.) (.) (.) (.) (1)
 17.         }
 18.         else {
 19.             scalar __se = _se[`v']
 20.             scalar __t = cond(__se>0,__b/__se,.)
 21.             scalar __p = cond(__se>0,2*ttail(e(df_r),abs(__t)),.)
 22.             scalar __crit = invttail(e(df_r),.025)
 23.             post `p_coefs' ("`mid'") ("`v'") (__b) (__se) (__t) (__p) (__b-__crit*__se) (__b+__crit*__se) (__se==0)
 24.         }
 25.     }
 26. }

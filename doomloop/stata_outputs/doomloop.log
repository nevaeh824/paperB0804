. * -----------------------------------------------------------------------------
. * Three nested specifications per equation. The cutoff is selected once from
. * the full-control equation and held fixed in every displayed column.
. * -----------------------------------------------------------------------------
. tempname p_stats p_coef p_equation

. postfile `p_stats' str24 model str12 equation double cutoff N countries years first_year last_year r2_within r2_overall df_r byte macro_controls external_controls using "`outdir'/model_stats.dta", replace

. postfile `p_coef' str24 model str12 equation str32 variable double coefficient se t p ci_low ci_high byte omitted using "`outdir'/model_coefficients.dta", replace

. postfile `p_equation' str24 model str244 equation_text using "`outdir'/equations.dta", replace

. 
. local dm1 "D1_core"

. local dr1 "debt_kink_low debt_kink_high debt_gdp `xcontrol'"

. local dq1 "DeltaDebt_lead = FE_i + FE_t + kink terms + rho_b*b + gamma_X*X + error"

. local dmc1 0

. local dec1 0

. local dm2 "D2_macro"

. local dr2 "debt_kink_low debt_kink_high debt_gdp `xcontrol' `macro_debt'"

. local dq2 "D1 + growth + inflation; current GDP excluded"

. local dmc2 1

. local dec2 0

. local dm3 "D3_full"

. local dr3 "debt_kink_low debt_kink_high debt_gdp `full_controls_debt'"

. local dq3 "D2 + reserves + terms of trade"

. local dmc3 1

. local dec3 1

. 
. forvalues z=1/3 {
  2.     local mid "`dm`z''"
  3.     local rhs "`dr`z''"
  4.     quietly xtreg delta_debt_lead `rhs' i.year if sample_debt, fe
  5.     local r2w = e(r2_w)
  6.     local r2o = e(r2_o)
  7.     quietly areg delta_debt_lead `rhs' i.year if sample_debt, absorb(country_id) vce(robust)
  8.     estimates store `mid'
  9.     post `p_stats' ("`mid'") ("debt") (scalar(rss_min_cutoff_debt)) (e(N)) (scalar(G_debt)) (scalar(T_debt)) (scalar(year_min_debt)) (scalar(year_max_debt)) (`r2w') (`r2o') (e(df_r)) (`dmc`z'') (`dec`z'')
 10.     post `p_equation' ("`mid'") ("`dq`z''")
 11.     foreach v of local rhs {
 12.         capture scalar __b = _b[`v']
 13.         if _rc {
 14.             post `p_coef' ("`mid'") ("debt") ("`v'") (.) (.) (.) (.) (.) (.) (1)
 15.         }
 16.         else {
 17.             scalar __se = _se[`v']
 18.             scalar __t = cond(__se>0,__b/__se,.)
 19.             scalar __p = cond(__se>0,2*ttail(e(df_r),abs(__t)),.)
 20.             scalar __crit = invttail(e(df_r),.025)
 21.             post `p_coef' ("`mid'") ("debt") ("`v'") (__b) (__se) (__t) (__p) (__b-__crit*__se) (__b+__crit*__se) (__se==0)
 22.         }
 23.     }
 24. }

. 
. local rm1 "R1_core"

. local rr1 "ready_kink_low ready_kink_high readiness_lag `xcontrol'"

. local rq1 "J = FE_i + FE_t + kink terms + rho_A*A_lag + gamma_X*X + error"

. local rmc1 0

. local rec1 0

. local rm2 "R2_macro"

. local rr2 "ready_kink_low ready_kink_high readiness_lag `xcontrol' `macro_ready'"

. local rq2 "R1 + growth + ln(CurrentGDP) + inflation"

. local rmc2 1

. local rec2 0

. local rm3 "R3_full"

. local rr3 "ready_kink_low ready_kink_high readiness_lag `full_controls_ready'"

. local rq3 "R2 + reserves + terms of trade"

. local rmc3 1

. local rec3 1

. 
. forvalues z=1/3 {
  2.     local mid "`rm`z''"
  3.     local rhs "`rr`z''"
  4.     quietly xtreg J_readiness `rhs' i.year if sample_ready, fe
  5.     local r2w = e(r2_w)
  6.     local r2o = e(r2_o)
  7.     quietly areg J_readiness `rhs' i.year if sample_ready, absorb(country_id) vce(robust)
  8.     estimates store `mid'
  9.     post `p_stats' ("`mid'") ("ready") (scalar(rss_min_cutoff_ready)) (e(N)) (scalar(G_ready)) (scalar(T_ready)) (scalar(year_min_ready)) (scalar(year_max_ready)) (`r2w') (`r2o') (e(df_r)) (`rmc`z'') (`rec`z'')
 10.     post `p_equation' ("`mid'") ("`rq`z''")
 11.     foreach v of local rhs {
 12.         capture scalar __b = _b[`v']
 13.         if _rc {
 14.             post `p_coef' ("`mid'") ("ready") ("`v'") (.) (.) (.) (.) (.) (.) (1)
 15.         }
 16.         else {
 17.             scalar __se = _se[`v']
 18.             scalar __t = cond(__se>0,__b/__se,.)
 19.             scalar __p = cond(__se>0,2*ttail(e(df_r),abs(__t)),.)
 20.             scalar __crit = invttail(e(df_r),.025)
 21.             post `p_coef' ("`mid'") ("ready") ("`v'") (__b) (__se) (__t) (__p) (__b-__crit*__se) (__b+__crit*__se) (__se==0)
 22.         }
 23.     }
 24. }


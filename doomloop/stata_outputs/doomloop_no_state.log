 10.     post `p_equation' ("`mid'") ("`dq`z''")
 11.     foreach v of local rhs {
 12.         capture scalar __b = _b[`v']
 13.         if _rc post `p_coef' ("`mid'") ("debt") ("`v'") (.) (.) (.) (.) (.) (.) (1)
 14.         else {
 15.             scalar __se = _se[`v']

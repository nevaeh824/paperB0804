. * Exact absorption checks. Threshold: residual SD <= 1e-10*max(1, overall SD).
. tempname p_absorb

. postfile `p_absorb' str32 variable byte country_absorbed time_absorbed twfe_absorbed double residual_sd tolerance using "`outdir'/absorption.dta", replace

. foreach v of local profilevars {
  2.     capture drop __sd_i __sd_t __twres
  3.     bysort country_id: egen double __sd_i = sd(`v')
  4.     quietly summarize __sd_i, meanonly
  5.     local maxsdi = cond(missing(r(max)),0,r(max))
  6.     bysort year: egen double __sd_t = sd(`v')
  7.     quietly summarize __sd_t, meanonly
  8.     local maxsdt = cond(missing(r(max)),0,r(max))
  9.     quietly summarize `v'
 10.     local tol = 1e-10*max(1,r(sd))
 11.     quietly regress `v' i.country_id i.year if !missing(`v')
 12.     predict double __twres if e(sample), residuals
 13.     quietly summarize __twres
 14.     local rsd = cond(missing(r(sd)),0,r(sd))
 15.     local ca = (`maxsdi'<=`tol')
 16.     local ta = (`maxsdt'<=`tol')
 17.     local tw = (`rsd'<=`tol')
 18.     post `p_absorb' ("`v'") (`ca') (`ta') (`tw') (`rsd') (`tol')
 19. }

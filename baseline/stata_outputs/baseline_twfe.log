. * Delta-method marginal effects at required moderator values.
. tempname p_me p_thr

. postfile `p_me' str24 model str20 moderator str20 point double moderator_value marginal_effect se t p ci_low ci_high using "`outdir'/marginal_effects.dta", replace

. postfile `p_thr' str24 model str20 moderator double threshold sample_min sample_max byte in_range using "`outdir'/thresholds.dta", replace

. 
. * Utility blocks are expanded explicitly to keep the do-file dependency-free.
. foreach spec in "Interact_AB b_pre int_AB" "Interact_AX wsdi_days int_AX" {
  2.     gettoken mid rest : spec
  3.     gettoken moderator interaction : rest
  4.     estimates restore `mid'
  5.     local mmean = scalar(mean_`moderator')
  6.     local msd   = scalar(sd_`moderator')
  7.     local pnames "P10 P25 P50 P75 P90 Mean_minus_1SD Mean Mean_plus_1SD"
  8.     local pvals  "`=scalar(p10_`moderator')' `=scalar(p25_`moderator')' `=scalar(p50_`moderator')' `=scalar(p75_`moderator')' `=scalar(p90_`moderator')' `=`mmean'-`msd'' `mmean' `=`mmean'+`msd''"
  9.     forvalues h=1/8 {
 10.         local pn : word `h' of `pnames'
 11.         local pv : word `h' of `pvals'
 12.         local centered = `pv'-`mmean'
 13.         quietly lincom c_A + (`centered')*`interaction'
 14.         post `p_me' ("`mid'") ("`moderator'") ("`pn'") (`pv') (r(estimate)) (r(se)) (r(estimate)/r(se)) (r(p)) (r(lb)) (r(ub))
 15.     }
 16.     scalar threshold = `mmean' - _b[c_A]/_b[`interaction']
 17.     scalar inrange = (threshold>=scalar(min_`moderator') & threshold<=scalar(max_`moderator'))
 18.     post `p_thr' ("`mid'") ("`moderator'") (threshold) (scalar(min_`moderator')) (scalar(max_`moderator')) (inrange)
 19. }
(results Interact_AB are active now)
(results Interact_AX are active now)


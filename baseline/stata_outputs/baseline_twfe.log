(594 missing values generated)

. foreach v of local ratio_vars {
  2.     recast double `v'
  3.     quietly summarize `v', meanonly
  4.     local source_min = r(min)
  5.     local source_max = r(max)
  6.     generate double __source_value = `v'
  7.     replace `v' = `v'/100
  8.     generate double __scale_diff = abs(`v'-__source_value/100) if !missing(__source_value)

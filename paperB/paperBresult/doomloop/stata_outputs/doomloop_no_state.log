> m_high double clusters str16 cluster_variable using "`outdir'/criterion_comparison.dta", replace

. 
. local criterion_keys theta debt ma ta bma

. foreach key of local criterion_keys {
  2.     if "`key'"=="theta" {
  3.         local qvar theta_hat_A
  4.         local qlabel "theta"
  5.     }
  6.     if "`key'"=="debt" {
  7.         local qvar b_it
  8.         local qlabel "b_it"
  9.     }
 10.     if "`key'"=="ma" {
 11.         local qvar mA_hat
 12.         local qlabel "mA"
 13.     }
 14.     if "`key'"=="ta" {
 15.         local qvar TA_hat
 16.         local qlabel "TA"
 17.     }
 18.     if "`key'"=="bma" {
 19.         local qvar b_it_mA_hat
 20.         local qlabel "b_it*mA"
 21.     }
 22. 
.     egen int criterion_missing_count_`key' = rowmiss(b_outcome readiness100 `qvar' `full_controls_debt')
 23.     generate byte sample_criterion_`key' = criterion_missing_count_`key'==0
 24.     quietly count if sample_criterion_`key'
 25.     scalar N_criterion_`key' = r(N)
 26. 
.     quietly summarize `qvar' if sample_criterion_`key', detail
 27.     scalar q_min_`key' = r(min)
 28.     scalar q_p1_`key' = r(p1)
 29.     scalar q_p10_`key' = r(p10)
 30.     scalar q_p25_`key' = r(p25)
 31.     scalar q_p50_`key' = r(p50)
 32.     scalar q_mean_`key' = r(mean)
 33.     scalar q_p75_`key' = r(p75)
 34.     scalar q_p90_`key' = r(p90)
 35.     scalar q_p99_`key' = r(p99)
 36.     scalar q_max_`key' = r(max)
 37.     format `qvar' %24.17g
 38.     * Search the complete observed support. The sample minimum and maximum are
.     * rejected below because one hinge would be identically zero there.
.     quietly levelsof `qvar' if sample_criterion_`key', local(candidates) clean
 39. 
.     scalar rss_min_`key' = .
 40.     scalar cutoff_`key' = .
 41.     scalar candidate_count_`key' = 0
 42.     scalar low_n_`key' = .
 43.     scalar high_n_`key' = .
 44.     generate double __hL = .
 45.     generate double __hH = .
 46.     generate double __xL = .
 47.     generate double __xH = .
 48.     local candidate_total : word count `candidates'
 49.     local candidate_index = 0
 50.     foreach c of local candidates {
 51.         local candidate_index = `candidate_index'+1
 52.         quietly count if sample_criterion_`key' & `qvar'<=`c'
 53.         local nlow = r(N)
 54.         quietly count if sample_criterion_`key' & `qvar'>`c'
 55.         local nhigh = r(N)
 56.         if `candidate_index'>1 & `candidate_index'<`candidate_total' {
 57.             quietly replace __hL = max(`c'-`qvar',0) if sample_criterion_`key'
 58.             quietly replace __hH = max(`qvar'-`c',0) if sample_criterion_`key'
 59.             quietly replace __xL = readiness100*__hL if sample_criterion_`key'
 60.             quietly replace __xH = readiness100*__hH if sample_criterion_`key'
 61.             quietly areg b_outcome __xL __xH `full_controls_debt' i.year if sample_criterion_`key', absorb(country_id) vce(cluster country_id)
 62.             local this_rss = e(rss)
 63.             post `p_profile' ("`qlabel'") ("`qvar'") (`c') (`this_rss') (e(N)) (`nlow') (`nhigh')
 64.             scalar candidate_count_`key' = scalar(candidate_count_`key')+1
 65.             if missing(scalar(rss_min_`key')) | `this_rss'<scalar(rss_min_`key') {
 66.                 scalar rss_min_`key' = `this_rss'
 67.                 scalar cutoff_`key' = `c'
 68.                 scalar low_n_`key' = `nlow'
 69.                 scalar high_n_`key' = `nhigh'
 70.             }
 71.         }
 72.     }
 73.     if missing(scalar(cutoff_`key')) {
 74.         display as error "No admissible cutoff for criterion `qlabel'."
 75.         postclose `p_profile'
 76.         postclose `p_compare'
 77.         postclose `p_formula'
 78.         log close nostatelog
 79.         exit 498
 80.     }
 81. 
.     quietly replace __hL = max(scalar(cutoff_`key')-`qvar',0) if sample_criterion_`key'
 82.     quietly replace __hH = max(`qvar'-scalar(cutoff_`key'),0) if sample_criterion_`key'
 83.     quietly replace __xL = readiness100*__hL if sample_criterion_`key'
 84.     quietly replace __xH = readiness100*__hH if sample_criterion_`key'
 85.     generate double __formula = readiness100*max(scalar(cutoff_`key')-`qvar',0) if sample_criterion_`key'
 86.     generate double __diff = abs(__xL-__formula) if sample_criterion_`key'
 87.     quietly summarize __diff, meanonly
 88.     scalar formula_low_`key' = cond(r(N)>0,r(max),.)
 89.     drop __formula __diff
 90.     generate double __formula = readiness100*max(`qvar'-scalar(cutoff_`key'),0) if sample_criterion_`key'
 91.     generate double __diff = abs(__xH-__formula) if sample_criterion_`key'
 92.     quietly summarize __diff, meanonly
 93.     scalar formula_high_`key' = cond(r(N)>0,r(max),.)
 94.     drop __formula __diff
 95. 
.     quietly xtreg b_outcome __xL __xH `full_controls_debt' i.year if sample_criterion_`key', fe vce(cluster country_id)
 96.     scalar __criterion_r2w = e(r2_w)
 97.     quietly areg b_outcome __xL __xH `full_controls_debt' i.year if sample_criterion_`key', absorb(country_id) vce(cluster country_id)
 98.     scalar __criterion_betaL = _b[__xL]
 99.     scalar __criterion_betaH = _b[__xH]
100.     scalar __criterion_pL = 2*ttail(e(df_r),abs(_b[__xL]/_se[__xL]))
101.     scalar __criterion_pH = 2*ttail(e(df_r),abs(_b[__xH]/_se[__xH]))
102.     scalar __criterion_rss = e(rss)
103.     local signL = cond(scalar(__criterion_betaL)>0,"+",cond(scalar(__criterion_betaL)<0,"-","0"))
104.     local signH = cond(scalar(__criterion_betaH)>0,"+",cond(scalar(__criterion_betaH)<0,"-","0"))
105.     local theory "No (`signL',`signH')"
106.     if (scalar(__criterion_betaL)>0 & scalar(__criterion_betaH)<0) local theory "Match (+,-)"
107.     else if (scalar(__criterion_betaL)>0 | scalar(__criterion_betaH)<0) local theory "Partial (`signL',`signH')"
108.     post `p_compare' ("`qlabel'") ("`qvar'") (scalar(cutoff_`key')) (scalar(__criterion_betaL)) (scalar(__criterion_pL)) (scalar(__criterion_betaH)) (scalar(__criterion_pH)) ("`theory'") (scalar(__criterion_rss)) (scalar(__criterion_r2w)) (e(N)) (sca

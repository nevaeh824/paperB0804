  7.     quietly areg b_outcome `rhs' i.year, absorb(country_id) vce(cluster country_id)
  8.     estimates store `mid'
  9.     quietly levelsof country_id if e(sample), local(__countries)
 10.     local __ng : word count `__countries'
 11.     quietly levelsof year if e(sample), local(__years)
 12.     local __nt : word count `__years'
 13.     quietly summarize year if e(sample), meanonly
 14.     post `p_stats' ("`mid'") ("debt") (scalar(rss_min_cutoff_debt_ns)) (e(N)) (`__ng') (`__nt') (r(min)) (r(max)) (`r2w') (`r2o') (e(rss)) (e(N_clust)) (e(df_r)) ("country_id") (`dmc`z'') (`dec`z'')
 15.     post `p_equation' ("`mid'") ("`dq`z''")
 16.     foreach v of local rhs {
 17.         capture scalar __b = _b[`v']
 18.         if _rc post `p_coef' ("`mid'") ("debt") ("`v'") (.) (.) (.) (.) (.) (.) (1)
 19.         else {
 20.             scalar __se = _se[`v']
 21.             scalar __t = cond(__se>0,__b/__se,.)
 22.             scalar __p = cond(__se>0,2*ttail(e(df_r),abs(__t)),.)
 23.             scalar __crit = invttail(e(df_r),.025)
 24.             post `p_coef' ("`mid'") ("debt") ("`v'") (__b) (__se) (__t) (__p) (__b-__crit*__se) (__b+__crit*__se) (__se==0)
 25.         }
 26.     }
 27. }

